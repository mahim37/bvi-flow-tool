# Where the dev server proxies /api. Only read by vite.config.ts, so it
# affects `npm run dev` and nothing that ships in a build.
#
# Local Django (default):
VITE_API_PROXY_TARGET=http://localhost:8000
#
# Hosted API (no local Django). Login + reads work; writes may 403 CSRF.
# VITE_API_PROXY_TARGET=https://bvi-dev.therewirelab.com
